<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net48;net481;net8.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>

        <!-- Package Information -->
        <PackageId>GetCNPJ</PackageId>
        <Version>1.1.0</Version>
        <Authors>Bruno da Cunha Felipe</Authors>
        <Company>FeTx</Company>
        <Description>Biblioteca de alta performance para consulta de CNPJ em APIs públicas brasileiras (CNPJ.WS, ReceitaWS, BrasilAPI, CNPJA). Suporta .NET Framework 4.8+, .NET 8, .NET 9 e .NET Standard 2.0 com rate limiting inteligente, fallback automático, injeção de dependência e cache em memória.</Description>
        <PackageTags>CNPJ;Brasil;ReceitaWS;BrasilAPI;CNPJA;CNPJWS;API;Consulta;Receita;Empresas;Cache;RateLimit</PackageTags>
        <RepositoryUrl>https://github.com/bruno-ferreira-tech/GetCNPJ</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>logo.png</PackageIcon>

        <!-- Symbols & SourceLink -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Text.Json" Version="8.0.5" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    </ItemGroup>

    <!-- Adiciona System.Net.Http para .NET Framework -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net48' OR '$(TargetFramework)' == 'net481'">
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
    </ItemGroup>

    <!-- README e Logo para o pacote NuGet -->
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="logo.png" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
